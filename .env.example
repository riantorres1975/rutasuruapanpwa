# Token PÚBLICO de Mapbox (se expone al cliente por diseño).
# IMPORTANTE: restríngelo por dominio (URL referrer) en el dashboard de Mapbox
# para que nadie pueda reutilizarlo desde otro sitio y consumir tu cuota.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.tu_token_publico_mapbox
# Production URL used in share links. Defaults to the Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL=https://rutasuruapanpwa.vercel.app
DEEPSEEK_API_KEY=sk-tu_token_deepseek

# Rate limiting durable y global entre instancias serverless (opcional pero
# recomendado en producción). Sin estas vars, el rate limit cae a memoria por
# instancia. Crea una base gratuita en https://upstash.com (Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alertas operativas para errores criticos del cliente. El endpoint debe usar
# HTTPS; el token Bearer es opcional. Las alertas no incluyen mensajes, stacks
# ni ubicacion del usuario. Se deduplican por huella y tienen un limite global.
ERROR_ALERT_WEBHOOK_URL=
ERROR_ALERT_WEBHOOK_TOKEN=

# Optional local-only route editor. Do not enable in public production unless protected.
DEBUG_ROUTE_SAVE_ENABLED=false
DEBUG_ROUTE_SAVE_TOKEN=usa_un_token_largo_si_activas_el_editor
